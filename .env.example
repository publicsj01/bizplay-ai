# ── LLM Provider ─────────────────────────────────────────────────────────────
# 로컬: ollama | 상용: anthropic | openai 호환: openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# ── Ollama (로컬 기본값) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding 서버 (bge-m3 via Ollama 또는 별도 vLLM) ────────────────────────
EMBED_BASE_URL=http://localhost:11434
EMBED_API_KEY=local
EMBED_MODEL=bge-m3
EMBED_DIMENSIONS=1024

# ── vLLM (OpenAI 호환 자체 서버) — LLM_PROVIDER=openai 시 사용 ───────────────
# LLM_PROVIDER=openai
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=local
# LLM_MODEL=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct-AWQ

# ── Anthropic — LLM_PROVIDER=anthropic 시 아래 주석 해제 ─────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6

# ── Reranker (선택, BAAI/bge-reranker-v2-m3) ─────────────────────────────────
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=20

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bizplay_chatbot

# ── RAG 파라미터 ───────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_HISTORY_TURNS=5

# ── 파일 업로드 ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── UI 인증 ────────────────────────────────────────────────────────────────────
UI_USERNAME=admin
UI_PASSWORD=admin

# ── 기본 법인 코드 ─────────────────────────────────────────────────────────────
DEFAULT_CORP_NO=DEFAULT
